FROM python:3.10-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# install dependencies
RUN pip install --no-cache-dir \
    torch \
    torchaudio \
    fastapi \
    "uvicorn[standard]" \
    click \
    sse-starlette \
    python-multipart \
    numpy \
    pyyaml \
    soundfile \
    tqdm \
    einops \
    rotary_embedding_torch \
    packaging \
    "beartype>=0.17" \
    librosa \
    imageio-ffmpeg \
    certifi

# copy the rest and launch
COPY . .
RUN useradd --create-home --shell /usr/sbin/nologin stemsplat \
 && chown -R stemsplat:stemsplat /app
USER stemsplat
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
